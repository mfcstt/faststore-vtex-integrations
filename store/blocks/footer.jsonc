{
  "footer": {
    "blocks": ["footer-layout.desktop", "footer-layout.mobile"]
  },
  
  /* ================== DESKTOP ================== */
  "footer-layout.desktop": {
    "props": {
      "backgroundColor": "#09090b",
      "borderTopLeftRadius": "16px",
      "borderTopRightRadius": "16px",
      "blockClass": "login-footer"
    },
    "children": ["flex-layout.row#footer-desktop"]
  },
  "flex-layout.row#footer-desktop": {
    "props": {
      "blockClass": "footer-row",
      "fullWidth": false,
      "preventHorizontalStretch": true,
      "horizontalAlign": "center",
      "verticalAlign": "middle",
      "paddingTop": 5,
      "paddingBottom": 5,
      "colGap": 6 
    },
    "children": ["image#15anos", "image#abiplast", "image#eucertplast", "image#iso"]
  },
  "image#15anos": {
    "props": {
      "src": "assets/15Anos.svg",
      "maxHeight": "70px",
      "alt": "15 Anos",
      "blockClass": "certificado"
    }
  },
  "image#abiplast": {
    "props": {
      "src": "assets/Abiplast.svg",
      "maxHeight": "70px",
      "alt": "Abiplast",
      "blockClass": "certificado"
    }
  },
  "image#eucertplast": {
    "props": {
      "src": "assets/EuCertPlast.svg",
      "maxHeight": "50px",
      "alt": "EuCertPlast",
      "blockClass": "certificado"
    }
  },
  "image#iso": {
    "props": {
      "src": "assets/Iso.svg",
      "maxHeight": "70px",
      "alt": "ISO",
      "blockClass": "certificado"
    }
  },

  /* ================== MOBILE ================== */
  "footer-layout.mobile": {
    "props": {
      "backgroundColor": "#09090b",
      "borderTopLeftRadius": "16px",
      "borderTopRightRadius": "16px",
      "blockClass": "login-footer"
    },
    "children": ["flex-layout.row#footer-mobile"]
  },
  "flex-layout.row#footer-mobile": {
    "props": {
      "blockClass": "footer-row",
      "fullWidth": false,
      "preventHorizontalStretch": true,
      "horizontalAlign": "center",
      "verticalAlign": "middle",
      "paddingTop": 5,
      "paddingBottom": 5,
      "colGap": 4 
    },
    "children": ["image#15anos-mobile", "image#abiplast-mobile", "image#eucertplast-mobile", "image#iso-mobile"]
  },
  "image#15anos-mobile": {
    "props": {
      "src": "assets/15Anos.svg",
      "maxHeight": "40px",
      "alt": "15 Anos",
      "blockClass": "certificado"
    }
  },
  "image#abiplast-mobile": {
    "props": {
      "src": "assets/Abiplast.svg",
      "maxHeight": "40px",
      "alt": "Abiplast",
      "blockClass": "certificado"
    }
  },
  "image#eucertplast-mobile": {
    "props": {
      "src": "assets/EuCertPlast.svg",
      "maxHeight": "28px",
      "alt": "EuCertPlast",
      "blockClass": "certificado"
    }
  },
  "image#iso-mobile": {
    "props": {
      "src": "assets/Iso.svg",
      "maxHeight": "40px",
      "alt": "ISO",
      "blockClass": "certificado"
    }
  }
}