{
  "footer": {
    "blocks": ["footer-layout.desktop", "footer-layout.mobile"]
  },
  "footer-layout.desktop": {
    "props": {
      "backgroundColor": "#09090b",
      "borderTopLeftRadius": "16px",
      "borderTopRightRadius": "16px"
    },
    "children": ["flex-layout.row#footer-desktop"]
  },
  "flex-layout.row#footer-desktop": {
    "props": {
      "blockClass": "footer-row",
      "fullWidth": true,
      "horizontalAlign": "center",
      "verticalAlign": "middle",
      "colGap": 7
    },
    "children": ["flex-layout.col#logo-15anos", "flex-layout.col#certificados", "flex-layout.col#pagamentos"]
  },
  "flex-layout.col#logo-15anos": {
    "props": {
      "verticalAlign": "middle",
      "horizontalAlign": "center"
    },
    "children": ["image#15anos"]
  },
  "image#15anos": {
    "props": {
      "src": "assets/15Anos.svg",
      "maxHeight": "220px",
      "alt": "15 Anos"
    }
  },
  "flex-layout.col#certificados": {
    "props": {
      "verticalAlign": "middle",
      "horizontalAlign": "left"
    },
    "children": ["rich-text#certificacoes-title", "flex-layout.row#certificados-images"]
  },
  "rich-text#certificacoes-title": {
    "props": {
      "text": "**CERTIFICAÇÕES**",
      "textColor": "white",
      "textAlignment": "LEFT",
      "blockClass": "certificacoes-title"
    }
  },
  "flex-layout.row#certificados-images": {
    "props": {
      "blockClass": "certificados-images",
      "fullWidth": true,
      "preventHorizontalStretch": true,
      "horizontalAlign": "left",
      "verticalAlign": "middle",
      "colGap": 5
    },
    "children": ["image#abiplast", "image#eucertplast", "image#iso"]
  },
  "image#abiplast": {
    "props": {
      "src": "assets/Abiplast.svg",
      "maxHeight": "80px",
      "alt": "Abiplast",
      "blockClass": "certificado"
    }
  },
  "image#eucertplast": {
    "props": {
      "src": "assets/EuCertPlast.svg",
      "maxHeight": "80px",
      "alt": "EuCertPlast",
      "blockClass": "certificado"
    }
  },
  "image#iso": {
    "props": {
      "src": "assets/Iso.svg",
      "maxHeight": "80px",
      "alt": "ISO",
      "blockClass": "certificado"
    }
  },
  "rich-text#pagamentos-title": {
    "props": {
      "text": "**FORMAS DE PAGAMENTO**",
      "textColor": "white",
      "textAlignment": "LEFT",
      "blockClass": "pagamentos-title"
